{
  "name": "orrery",
  "version": "0.1.0",
  "description": "A markdown editor and knowledge base that reads the shape of what you write",
  "main": "./out/main/index.js",
  "author": "Iskandar Putra",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "private": true,
  "scripts": {
    "build": "npm run typecheck && electron-vite build",
    "build:native": "bash scripts/build-native.sh",
    "dev": "electron-vite dev",
    "dist": "bash scripts/package.sh",
    "dist:deb": "bash scripts/package.sh deb",
    "e2e": "npm run build && bash scripts/playwright.sh",
    "e2e:run": "bash scripts/playwright.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "package:linux": "npm run build && electron-builder --linux",
    "package:mac": "npm run build && electron-builder --mac",
    "package:win": "npm run build && electron-builder --win",
    "prebuild": "npm run sync:assets",
    "predev": "npm run sync:assets",
    "start": "electron-vite preview",
    "sync:assets": "node scripts/sync-assets.mjs",
    "test": "vitest run --maxWorkers=1",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "prettier": "^3.9.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@embedpdf/pdfium": "^2.15.0",
    "@excalidraw/excalidraw": "^0.18.1",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/newsreader": "^5.2.10",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.6.4",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@replit/codemirror-indentation-markers": "^6.5.3",
    "@replit/codemirror-minimap": "^0.5.2",
    "@replit/codemirror-vim": "^6.4.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "chokidar": "^5.0.0",
    "katex": "^0.17.0",
    "marked": "^18.0.5",
    "mermaid": "^11.16.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tesseract.js": "^7.0.0",
    "tesseract.js-core": "^7.0.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "homepage": "https://github.com/iskandarputra/orrery#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iskandarputra/orrery.git"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  },
  "bugs": {
    "url": "https://github.com/iskandarputra/orrery/issues"
  },
  "keywords": [
    "markdown",
    "notes",
    "knowledge-base",
    "editor",
    "electron",
    "codemirror",
    "wikilinks"
  ]
}
